{
  "title": "allOf conditional breaks select-inline switcher",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "item": {
      "title": "Item",
      "x-switcherInput": "select-inline",
      "anyOf": [
        {
          "x-switcherTitle": "Branch A",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "a"
            },
            "label": {
              "type": "string"
            }
          }
        },
        {
          "x-switcherTitle": "Branch B",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "b"
            },
            "mode": {
              "type": "string",
              "enum": [
                "x",
                "y"
              ]
            },
            "foo": {
              "type": "string"
            },
            "bar": {
              "type": "string"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "mode": {
                    "const": "x"
                  }
                }
              },
              "then": {
                "required": [
                  "foo"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "mode": {
                    "const": "y"
                  }
                }
              },
              "then": {
                "required": [
                  "bar"
                ]
              }
            }
          ]
        }
      ]
    },
    "nested": {
      "title": "Nested",
      "x-switcherInput": "select-inline",
      "anyOf": [
        {
          "x-switcherTitle": "Branch A",
          "type": ["string", "integer"],
          "x-switcherInput": "select-inline"
        },
        {
          "x-switcherTitle": "Branch B",
          "type": ["boolean", "number"],
          "x-switcherInput": "select-inline"
        }
      ]
    },
    "nestedModal": {
      "title": "Nested Modal",
      "x-switcherInput": "modal",
      "anyOf": [
        {
          "x-switcherTitle": "Branch A",
          "type": ["string", "integer"],
          "x-switcherInput": "modal"
        },
        {
          "x-switcherTitle": "Branch B",
          "type": ["boolean", "number"],
          "x-switcherInput": "modal"
        }
      ]
    },
    "nestedMixed": {
      "title": "Nested Mixed",
      "x-switcherInput": "select-inline",
      "anyOf": [
        {
          "x-switcherTitle": "Branch A",
          "type": ["string", "integer"],
          "x-switcherInput": "modal"
        },
        {
          "x-switcherTitle": "Branch B",
          "type": ["boolean", "number"],
          "x-switcherInput": "modal"
        }
      ]
    },
    "anyof": {
      "title": "Any Of",
      "x-info": {
        "variant": "modal",
        "title": "### Info Button title",
        "content": "Info button content"
      },
      "anyOf": [
        {
          "type": "array",
