{
  "$ref": "#/$defs/Node",
  "$defs": {
    "Node": {
      "type": "object",
      "required": ["type", "name"],
      "properties": {
        "type": { "type": "string" },
        "name": { "type": "string" },
        "children": { "type": "array", "items": { "$ref": "#/$defs/Node" } }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "leaf" } } },
          "then": { "properties": { "children": { "type": "array", "maxItems": 0 } } },
          "else": { "required": ["children"] }
        }
      ]
    }
  }
}