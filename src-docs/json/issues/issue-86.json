  "properties": {
    "table": {
      "title": "Table",
      "type": "array",
      "x-format": "table",
      "default": ["a", "b"],
      "items": {
        "type": "string",
        "title": "Item"
      }
    },
    "tableObject": {
      "title": "Table object",
      "type": "array",
      "x-format": "table-object",
      "default": [
        { "fieldA": "a", "fieldB": "b" }
      ],
      "items": {
        "type": "object",
        "properties": {
          "fieldA": { "type": "string", "title": "Field A" },
          "fieldB": { "type": "string", "title": "Field B" }
        }
      }
    },
    "tuple": {
      "title": "Tuple",
      "type": "array",
      "x-format": "tuple",
      "prefixItems": [
        { "type": "string", "title": "First" },
        { "type": "number", "title": "Second" }
      ]
    }
  }
