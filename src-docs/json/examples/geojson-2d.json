{
  "title": "GeoJSON 2D",
  "x-discriminator": "type",
  "x-switcherInput": "select-inline",
  "oneOf": [
    { "$ref": "#/definitions/point" },
    { "$ref": "#/definitions/lineString" },
    { "$ref": "#/definitions/polygon" },
    { "$ref": "#/definitions/multiPoint" },
    { "$ref": "#/definitions/multiLineString" },
    { "$ref": "#/definitions/multiPolygon" },
    { "$ref": "#/definitions/geometryCollection" },
    { "$ref": "#/definitions/feature" },
    { "$ref": "#/definitions/featureCollection" }
  ],
  "definitions": {
    "position": {
      "title": "Position",
      "type": "array",
      "x-format": "tuple",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        { "title": "Longitude", "type": "number" },
        { "title": "Latitude", "type": "number" }
      ]
    },
    "bbox": {
      "title": "Bounding Box",
      "type": "array",
      "x-format": "tuple",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        { "title": "West Longitude", "type": "number" },
        { "title": "South Latitude", "type": "number" },
        { "title": "East Longitude", "type": "number" },
        { "title": "North Latitude", "type": "number" }
      ]
    },
    "point": {
      "title": "GeoJSON Point",
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "coordinates"],
      "properties": {
        "type": {
          "title": "Type",
          "type": "string",
          "const": "Point",
          "default": "Point",
          "readOnly": true,
          "x-hidden": true
        },
        "coordinates": {
          "title": "Coordinates",
          "$ref": "#/definitions/position"
        },
        "bbox": {
          "title": "Bounding Box",
          "x-propertyOrder": 10,
          "$ref": "#/definitions/bbox"
        }
      }
    },
    "lineString": {
      "title": "GeoJSON LineString",
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "coordinates"],
      "properties": {
        "type": {
          "title": "Type",
          "type": "string",
          "const": "LineString",
          "default": "LineString",
          "readOnly": true,
          "x-hidden": true
        },
        "coordinates": {
          "title": "Coordinates",
          "type": "array",
          "minItems": 2,
          "x-format": "nav-vertical",
          "x-titleTemplate": "{{ i1 }}) {{ value.0 }}, {{ value.1 }}",
          "items": { "title": "Position", "$ref": "#/definitions/position" }
        },
        "bbox": {
          "title": "Bounding Box",
          "x-propertyOrder": 10,
          "$ref": "#/definitions/bbox"
        }
      }
    },
    "polygon": {
      "title": "GeoJSON Polygon",
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "coordinates"],
      "properties": {
        "type": {
          "title": "Type",
          "type": "string",
          "const": "Polygon",
          "default": "Polygon",
          "readOnly": true,
          "x-hidden": true
        },
        "coordinates": {
          "title": "Coordinates",
          "type": "array",
          "minItems": 1,
          "x-format": "nav-vertical",
          "x-titleTemplate": "Ring {{ i1 }}",
          "items": {
            "title": "Linear Ring",
            "type": "array",
            "minItems": 4,
            "x-format": "nav-vertical",
            "x-titleTemplate": "{{ i1 }}) {{ value.0 }}, {{ value.1 }}",
            "items": { "title": "Position", "$ref": "#/definitions/position" }
          }
        },
        "bbox": {
          "title": "Bounding Box",
          "x-propertyOrder": 10,
          "$ref": "#/definitions/bbox"
        }
      }
    },
    "multiPoint": {
      "title": "GeoJSON MultiPoint",
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "coordinates"],
      "properties": {
        "type": {
          "title": "Type",
          "type": "string",
          "const": "MultiPoint",
          "default": "MultiPoint",
          "readOnly": true,
          "x-hidden": true
        },
        "coordinates": {
          "title": "Coordinates",
          "type": "array",
          "x-format": "nav-vertical",
          "x-titleTemplate": "{{ i1 }}) {{ value.0 }}, {{ value.1 }}",
          "items": { "title": "Position", "$ref": "#/definitions/position" }
        },
        "bbox": {
          "title": "Bounding Box",
          "x-propertyOrder": 10,
          "$ref": "#/definitions/bbox"
        }
      }
    },
    "multiLineString": {
      "title": "GeoJSON MultiLineString",
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "coordinates"],
      "properties": {
        "type": {
          "title": "Type",
          "type": "string",
          "const": "MultiLineString",
          "default": "MultiLineString",
          "readOnly": true,
          "x-hidden": true
        },
        "coordinates": {
          "title": "Coordinates",
          "type": "array",
          "x-format": "nav-vertical",
          "x-titleTemplate": "Line {{ i1 }}",
          "items": {
            "title": "Line",
            "type": "array",
            "minItems": 2,
            "x-format": "nav-vertical",
            "x-titleTemplate": "{{ i1 }}) {{ value.0 }}, {{ value.1 }}",
            "items": { "title": "Position", "$ref": "#/definitions/position" }
          }
        },
        "bbox": {
          "title": "Bounding Box",
          "x-propertyOrder": 10,
          "$ref": "#/definitions/bbox"
        }
      }
    },
    "multiPolygon": {
      "title": "GeoJSON MultiPolygon",
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "coordinates"],
      "properties": {
        "type": {
          "title": "Type",
          "type": "string",
          "const": "MultiPolygon",
          "default": "MultiPolygon",
          "readOnly": true,
          "x-hidden": true
        },
        "coordinates": {
          "title": "Coordinates",
          "type": "array",
          "x-format": "nav-vertical",
          "x-titleTemplate": "Polygon {{ i1 }}",
          "items": {
            "title": "Polygon",
            "type": "array",
            "minItems": 1,
            "x-format": "nav-vertical",
            "x-titleTemplate": "Ring {{ i1 }}",
            "items": {
              "title": "Linear Ring",
              "type": "array",
              "minItems": 4,
              "x-format": "nav-vertical",
              "x-titleTemplate": "{{ i1 }}) {{ value.0 }}, {{ value.1 }}",
              "items": { "title": "Position", "$ref": "#/definitions/position" }
            }
          }
        },
        "bbox": {
          "title": "Bounding Box",
          "x-propertyOrder": 10,
          "$ref": "#/definitions/bbox"
        }
      }
    },
    "geometry": {
      "title": "Geometry",
      "x-discriminator": "type",
      "x-switcherInput": "select-inline",
      "oneOf": [
        { "$ref": "#/definitions/point" },
        { "$ref": "#/definitions/lineString" },
        { "$ref": "#/definitions/polygon" },
        { "$ref": "#/definitions/multiPoint" },
        { "$ref": "#/definitions/multiLineString" },
        { "$ref": "#/definitions/multiPolygon" }
      ]
    },
    "geometryCollection": {
      "title": "GeoJSON GeometryCollection",
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "geometries"],
      "properties": {
        "type": {
          "title": "Type",
          "type": "string",
          "const": "GeometryCollection",
          "default": "GeometryCollection",
          "readOnly": true,
          "x-hidden": true
        },
        "geometries": {
          "title": "Geometries",
          "type": "array",
          "x-format": "nav-vertical",
          "x-titleTemplate": "{{ i1 }}) {{ value.type }}",
          "items": { "title": "Geometry", "$ref": "#/definitions/geometry" }
        },
        "bbox": {
          "title": "Bounding Box",
          "x-propertyOrder": 10,
          "$ref": "#/definitions/bbox"
        }
      }
    },
    "feature": {
      "title": "GeoJSON Feature",
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "properties", "geometry"],
      "properties": {
        "type": {
          "title": "Type",
          "type": "string",
          "const": "Feature",
          "default": "Feature",
          "readOnly": true,
          "x-hidden": true
        },
        "id": {
          "title": "ID",
          "x-switcherInput": "radios-inline",
          "oneOf": [
            { "title": "Numeric ID", "type": "number" },
            { "title": "String ID", "type": "string", "minLength": 1 }
          ]
        },
        "properties": {
          "title": "Properties",
          "type": ["object", "null"],
          "x-switcherInput": "radios-inline"
        },
        "geometry": {
          "title": "Geometry",
          "x-discriminator": "type",
          "x-switcherInput": "select-inline",
          "oneOf": [
            { "title": "Null Geometry", "type": "null" },
            { "$ref": "#/definitions/point" },
            { "$ref": "#/definitions/lineString" },
            { "$ref": "#/definitions/polygon" },
            { "$ref": "#/definitions/multiPoint" },
            { "$ref": "#/definitions/multiLineString" },
            { "$ref": "#/definitions/multiPolygon" },
            { "$ref": "#/definitions/geometryCollection" }
          ]
        },
        "bbox": {
          "title": "Bounding Box",
          "x-propertyOrder": 10,
          "$ref": "#/definitions/bbox"
        }
      }
    },
    "featureCollection": {
      "title": "GeoJSON FeatureCollection",
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "features"],
      "properties": {
        "type": {
          "title": "Type",
          "type": "string",
          "const": "FeatureCollection",
          "default": "FeatureCollection",
          "readOnly": true,
          "x-hidden": true
        },
        "features": {
          "title": "Features",
          "type": "array",
          "x-format": "nav-vertical",
          "x-titleTemplate": "{{ i1 }}) {{ value.geometry.type }}",
          "items": { "title": "Feature", "$ref": "#/definitions/feature" }
        },
        "bbox": {
          "title": "Bounding Box",
          "x-propertyOrder": 10,
          "$ref": "#/definitions/bbox"
        }
      }
    }
  }
}